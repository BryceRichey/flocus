generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id        Int      @id @default(autoincrement())
  auth0id   String   @unique
  email     String   @unique
  f_name    String
  l_name    String
  createdAt DateTime @default(now())
}

// NEED TO ADD USER ID CONNECTION WITH BOARDS ETC.
model Boards {
  id    Int     @id @default(autoincrement())
  boardName  String  @db.VarChar(250)
  lists Lists[]
}

model Lists {
  id       Int     @id @default(autoincrement())
  listName     String
  board    Boards  @relation(fields: [boards], references: [id])
  boards Int
  cards    Cards[]
}

model Cards {
  id      Int    @id @default(autoincrement())
  cardName    String
  list   Lists  @relation(fields: [listsId], references: [id])
  listsId Int
}
